{
  "framework": null,
  "buildCommand": "node patch-wayforth.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/build",
      "destination": "/index.html"
    },
    {
      "source": "/trucking",
      "destination": "/index.html"
    },
    {
      "source": "/media",
      "destination": "/index.html"
    },
    {
      "source": "/quote",
      "destination": "/index.html"
    }
  ]
}